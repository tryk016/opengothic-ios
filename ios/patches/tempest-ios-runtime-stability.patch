 MtDevice::~MtDevice() {
+#if defined(__IOS__)
+  Log::i("Metal shader module cache: unique=",shaderCacheMisses,
+         " reused=",shaderCacheHits,
+         " resident=",shaderCache.size(),
+         " limit=",MaxShaderCacheEntries);
+#endif
