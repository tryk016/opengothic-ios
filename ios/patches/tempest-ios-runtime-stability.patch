+#if defined(__IOS__)
+static uint64_t shaderHash(const void* source, size_t size) {
+  constexpr uint64_t Offset = 1469598103934665603ull;
+  constexpr uint64_t Prime  = 1099511628211ull;
+  auto bytes = reinterpret_cast<const uint8_t*>(source);
+  uint64_t hash = Offset;
+  for(size_t i=0; i<size; ++i) {
+    hash ^= bytes[i];
+    hash *= Prime;
+    }
+  return hash;
   }
 
+AbstractGraphicsApi::PShader MtDevice::createShader(const void* source, size_t size) {
+  const uint64_t hash = shaderHash(source,size);
+  std::lock_guard<std::mutex> guard(shaderCacheSync);
+  const auto range = shaderCache.equal_range(hash);
+  for(auto i=range.first; i!=range.second; ++i) {
+    const auto& bytecode = i->second.bytecode;
+    if(bytecode.size()==size && std::memcmp(bytecode.data(),source,size)==0) {
+      i->second.lastUse = ++shaderCacheClock;
+      ++shaderCacheHits;
+      return i->second.shader;
+      }
+    }
+
+  auto shader = AbstractGraphicsApi::PShader(new MtShader(*this,source,size));
+  if(shaderCache.size()>=MaxShaderCacheEntries) {
+    auto oldest = shaderCache.begin();
+    for(auto i=shaderCache.begin(); i!=shaderCache.end(); ++i) {
+      if(i->second.lastUse<oldest->second.lastUse)
+        oldest = i;
+      }
+    shaderCache.erase(oldest);
+    }
+  ShaderCacheEntry entry;
+  auto begin = reinterpret_cast<const uint8_t*>(source);
+  entry.bytecode.assign(begin,begin+size);
+  entry.shader = shader;
+  entry.lastUse = ++shaderCacheClock;
+  shaderCache.emplace(hash,std::move(entry));
+  ++shaderCacheMisses;
+  return shader;
+  }
+
+void MtDevice::releaseCachedShader(const AbstractGraphicsApi::Shader* shader) {
+  std::lock_guard<std::mutex> guard(shaderCacheSync);
+  for(auto i=shaderCache.begin(); i!=shaderCache.end(); ++i) {
+    if(i->second.shader.handler==shader) {
+      shaderCache.erase(i);
+      return;
+      }
+    }
+  }
+#endif
